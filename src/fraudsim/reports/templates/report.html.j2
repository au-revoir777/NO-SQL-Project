<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ m.title }}</title>
<style>
@page {
  size: A4;
  margin: 18mm 16mm 20mm;
  @bottom-left { content: "{{ m.disclaimer }}"; font: 7.5pt Arial, Helvetica, sans-serif; color: #444; }
  @bottom-right { content: "Page " counter(page) " of " counter(pages); font: 7.5pt Arial, Helvetica, sans-serif; color: #444; }
}
* { box-sizing: border-box; }
body { font: 9.5pt/1.45 Arial, Helvetica, sans-serif; color: #111; margin: 0 auto; max-width: 180mm; padding: 8mm 0; background: #fff; }
h1 { font-size: 17pt; margin: 0 0 2mm; }
h2 { font-size: 12pt; margin: 7mm 0 2mm; border-bottom: 0.5pt solid #999; padding-bottom: 1mm; break-after: avoid; }
h3 { font-size: 10pt; margin: 4mm 0 1.5mm; break-after: avoid; }
p { margin: 1.5mm 0; }
table { border-collapse: collapse; width: 100%; margin: 2mm 0; font-size: 8.5pt; }
th, td { border-bottom: 0.4pt solid #bbb; padding: 1mm 1.5mm; text-align: left; vertical-align: top; }
th { background: #f0f0f0; font-weight: 600; }
td.n, th.n { text-align: right; font-variant-numeric: tabular-nums; }
code { font-family: "Courier New", monospace; font-size: 8pt; word-break: break-all; }
td code { white-space: nowrap; word-break: normal; }
.meta { color: #333; font-size: 8.5pt; }
.box { border: 0.6pt solid #888; padding: 2.5mm 3mm; margin: 2mm 0; break-inside: avoid; }
.warn { border-color: #8f5f08; background: #fff8e6; }
.ring { break-before: page; }
.figs { display: flex; gap: 4mm; flex-wrap: wrap; align-items: flex-start; }
.figs svg { max-width: 100%; height: auto; }
figure { margin: 0; }
.oracle { border: 0.8pt dashed #8f5f08; padding: 2.5mm 3mm; }
.disclaimer { font-weight: 600; }
ul { margin: 1mm 0 1mm 5mm; padding: 0; }
</style>
</head>
<body>
<header>
  <h1>{{ m.title }}</h1>
  <p class="meta">Investigation report · FraudSim {{ m.version }} · generated <span id="generated-at">{{ generated_at }}</span></p>
  <p class="meta">Runs: {% for r in m.run_ids %}<code>{{ r }}</code>{% if not loop.last %}, {% endif %}{% else %}none{% endfor %}
  · scenario config hashes: {% for h in m.config_hashes %}<code>{{ h[:16] }}</code>{% if not loop.last %}, {% endif %}{% else %}none{% endfor %}</p>
  <p class="box disclaimer">{{ m.disclaimer }}</p>
</header>

{% if "executive_summary" in m.sections %}
<section id="executive-summary">
<h2>Executive summary</h2>
{% set s = m.summary %}
<p>This report covers {{ s.rings | fmt }} flagged ring(s) ({{ s.alerts | fmt }} alert(s), {{ s.early_warnings | fmt }} early warning(s))
involving {{ s.members | fmt }} account(s), from {{ s.runs | fmt }} run(s){% if s.cases %} and {{ s.cases | fmt }} case(s){% endif %}.
{% if s.max_risk is not none %}The highest risk score is {{ s.max_risk | fmt(3) }}. {% endif %}
{{ s.labelled | fmt }} of the rings carry an analyst label.</p>
{% if s.ring_types %}<p>Ring types: {% for t, n in s.ring_types.items() %}{{ t | words }} ({{ n }}){% if not loop.last %}, {% endif %}{% endfor %}.</p>{% endif %}
{% for c in m.cases %}
<div class="box"><strong>Case #{{ c.id }}: {{ c.title }}</strong> · {{ c.status | words }} · priority {{ c.priority }}
· assignee {{ c.assignee or "unassigned" }} · opened by {{ c.created_by or "–" }} on {{ c.created_at[:19] }}
{% if c.resolution %}<br>Resolution: {{ c.resolution }}{% endif %}
<br>Alerts: {% for a in c.alert_refs %}<code>{{ a }}</code>{% if not loop.last %}, {% endif %}{% endfor %}</div>
{% endfor %}
</section>
{% endif %}

{% if "alert_table" in m.sections %}
<section id="alert-table">
<h2>Alerts</h2>
{% if m.rings %}
<table>
<thead><tr><th>Ring</th><th>Run</th><th>Kind</th><th>Type</th><th class="n">Risk</th><th class="n">Threshold</th><th>Bucket</th><th class="n">Members</th><th>Detectors</th><th>Status</th><th>First seen (sim)</th></tr></thead>
<tbody>
{% for r in m.rings %}
<tr><td><code>{{ r.ring_id }}</code></td><td><code>{{ r.run_id }}</code></td><td>{{ (r.kind or "–") | words }}</td><td>{{ r.ring_type | words }}</td>
<td class="n">{{ r.risk | fmt(3) }}</td><td class="n">{{ r.threshold | fmt(3) }}</td><td>{{ (r.calibration_bucket or "–").split(" ")[0] }}</td>
<td class="n">{{ r.members | length }}</td><td>{{ r.detectors | map("words") | join(", ") }}</td><td>{{ r.status or "not triaged" }}</td><td>{{ (r.first_seen or "–")[:19] }}</td></tr>
{% endfor %}
</tbody>
</table>
{% else %}<p>No alerts in scope.</p>{% endif %}
</section>
{% endif %}

{% if "sar_summary" in m.sections %}
{% set sar = m.sar %}
<section id="sar-summary">
<h2>SAR-style summary</h2>
<p class="box warn">Structured like a suspicious-activity summary for research and teaching. {{ m.disclaimer }}</p>
<h3>Subject entities</h3>
<p>{{ sar.subjects | length }} account(s): {% for x in sar.subjects %}<code>{{ x }}</code>{% if not loop.last %}, {% endif %}{% endfor %}</p>
<p>Shared attributes: {% for a in sar.attributes %}<code>{{ a }}</code>{% if not loop.last %}, {% endif %}{% else %}none{% endfor %}</p>
<h3>Activity summary</h3>
<p>{{ sar.transfers | fmt }} transfer(s) among subjects in the evidence, totalling {{ sar.amount | fmt }} (simulated currency).
Activity window (simulated time): {{ (sar.first or "–")[:19] }} to {{ (sar.last or "–")[:19] }}.</p>
<h3>Typology</h3>
<p>{{ sar.typology | map("words") | join(", ") or "–" }}; detected by {{ sar.detectors | map("words") | join(", ") or "–" }}.</p>
<h3>Evidence references</h3>
<ul>{% for e in sar.evidence %}<li>run <code>{{ e.run_id }}</code> ring <code>{{ e.ring_id }}</code>{% if e.snapshot_sha256 %} · frozen evidence SHA-256 <code>{{ e.snapshot_sha256 }}</code>{% endif %}</li>{% endfor %}</ul>
<h3>Analyst narrative</h3>
{% for n in sar.narrative %}<p><strong>{{ n.author or "unknown" }}</strong>, {{ n.created_at[:19] }}{% if n.edited %} (edited){% endif %}: {{ n.body }}</p>{% else %}<p>No analyst notes.</p>{% endfor %}
</section>
{% endif %}

{% if "run_metrics" in m.sections %}
<section id="run-metrics">
<h2>Runs</h2>
{% for run in m.runs %}
<h3>Run <code>{{ run.run_id }}</code></h3>
{% if run.facts %}{% set f = run.facts %}
<table>
<tbody>
<tr><th>Scenario / seed</th><td>{{ f.scenario }} / {{ f.seed }}</td></tr>
<tr><th>Scenario config hash</th><td><code>{{ f.config_hash }}</code></td></tr>
<tr><th>Event stream digest</th><td><code>{{ f.stream_digest }}</code></td></tr>
<tr><th>Scoring model</th><td>{{ f.model_path or "none" }}{% if f.model_sha256 %} · SHA-256 <code>{{ f.model_sha256 }}</code>{% endif %}</td></tr>
<tr><th>Events</th><td class="n" data-metric="events">{{ f.events | fmt }}</td></tr>
<tr><th>Transactions (amount)</th><td class="n" data-metric="transactions">{{ f.transactions | fmt }} ({{ f.transaction_amount | fmt }})</td></tr>
<tr><th>Simulated time</th><td>{{ (f.first_event_ts or "–")[:19] }} to {{ (f.last_event_ts or "–")[:19] }}</td></tr>
<tr><th>Rings tracked / ring updates</th><td class="n" data-metric="rings">{{ f.rings_tracked | fmt }} / {{ f.ring_updates | fmt }}</td></tr>
<tr><th>Alerts / early warnings raised</th><td class="n" data-metric="raised">{{ f.alerts_raised | fmt }} / {{ f.early_warnings_raised | fmt }}</td></tr>
</tbody>
</table>
<p class="meta">Events by type: {% for t, n in f.events_by_type.items() %}{{ t | words }} {{ n | fmt }}{% if not loop.last %} · {% endif %}{% endfor %}.
Ring changes: {% for t, n in f.ring_updates_by_change.items() %}{{ t | words }} {{ n | fmt }}{% if not loop.last %} · {% endif %}{% endfor %}.</p>
{% if f.oracle %}
<div class="oracle">
<h3>{{ f.oracle.label }}</h3>
{% if f.oracle.available %}
<p>{{ f.oracle.matched }} of {{ f.oracle.raised_rings }} raised rings match one of the {{ f.oracle.true_rings }} simulated rings
(precision {{ f.oracle.precision | fmt(3) }}, recall {{ f.oracle.recall | fmt(3) }}; {{ f.oracle.match_rule }}).
Missed simulated rings: {{ f.oracle.missed | length }}. Raised rings with no match: {{ f.oracle.unmatched_raised | length }}.</p>
{% else %}<p>No ground-truth ledger in this run's logs.</p>{% endif %}
</div>
{% endif %}
{% else %}<p>No logs found for this run (it was not recorded to disk, or the files were removed).</p>{% endif %}
{% endfor %}
</section>
{% endif %}

{% if "limitations" in m.sections %}
<section id="limitations">
<h2>Limitations and uncertainty</h2>
<ul>
<li>All data is simulated (or from public research datasets). {{ m.disclaimer }}</li>
<li>Risk scores come from the run's scoring model (SHA-256 above). Experiment E10 found that its calibration does not transfer to ring-level alerts: ring-level expected calibration error 0.10, and rings scored 0.8–0.9 were true rings 29% of the time (0.9–1.0: 74%). Read risk as a ranking, not a probability.</li>
<li>Risk, members and evidence shown for a ring are its latest values in the app database, the frozen copy when the ring is attached to a case (hash given), or the run log's record when it was raised.</li>
<li>Ground-truth comparisons appear only in sections labelled "{{ m.oracle_label }}", and only when requested.</li>
<li>Counterfactuals describe the scoring model, not the world: they say what would have to change for the model not to flag the ring.</li>
</ul>
</section>
{% endif %}

{% for r in m.rings %}
{% if "ring_detail" in m.sections or "contributions" in m.sections or "counterfactuals" in m.sections or "timeline" in m.sections or "notes" in m.sections %}
<section class="ring" id="ring-{{ r.run_id }}-{{ r.ring_id }}">
<h2>Ring <code>{{ r.ring_id }}</code> ({{ r.ring_type | words }})</h2>
<p class="meta">Run <code>{{ r.run_id }}</code> · risk {{ r.risk | fmt(3) }} (threshold {{ r.threshold | fmt(3) }}) · {{ r.members | length }} members · detectors {{ r.detectors | map("words") | join(", ") }}
{% if r.snapshot_sha256 %} · frozen evidence SHA-256 <code>{{ r.snapshot_sha256 }}</code>{% endif %}
{% if r.case_ids %} · case(s) {% for c in r.case_ids %}#{{ c }}{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}</p>
{% if "ring_detail" in m.sections %}
<p>{{ r.reason or "No reason recorded." }}</p>
<p>Members: {% for u in r.members %}<code>{{ u }}</code>{% if not loop.last %}, {% endif %}{% endfor %}</p>
{% if r.shared_attributes %}
<table><thead><tr><th>Shared attribute</th><th>Kind</th><th class="n">Active users</th><th class="n">Hub weight</th></tr></thead><tbody>
{% for a in r.shared_attributes %}<tr><td><code>{{ a.id }}</code></td><td>{{ a.kind }}</td><td class="n">{{ a.degree | fmt }}</td><td class="n">{{ a.hub_weight | fmt(4) }}</td></tr>{% endfor %}
</tbody></table>
{% endif %}
{% endif %}
<div class="figs">
{% if r.evidence_svg %}<figure><figcaption class="meta">Evidence subgraph: members (circles), the devices, cards and IPs they share, and transfers among members (arrows).</figcaption>{{ r.evidence_svg | safe }}</figure>{% endif %}
{% if r.contributions_svg %}<figure><figcaption class="meta">Feature contributions to the score (log-odds).</figcaption>{{ r.contributions_svg | safe }}</figure>{% endif %}
</div>
{% if "counterfactuals" in m.sections %}
<h3>Counterfactuals</h3>
{% if r.counterfactuals %}<ul>{% for c in r.counterfactuals %}<li>{{ c }}</li>{% endfor %}</ul>{% else %}<p>None computed.</p>{% endif %}
{% endif %}
{% if "timeline" in m.sections and r.history %}
<h3>Timeline (simulated time)</h3>
<table><thead><tr><th>Time</th><th>Change</th><th>Status</th><th class="n">Members</th><th class="n">Score</th></tr></thead><tbody>
{% for h in r.history %}<tr><td>{{ h.ts[:19] }}</td><td>{{ h.change | words }}</td><td>{{ h.status | words }}</td><td class="n">{{ h.members }}</td><td class="n">{{ h.score | fmt(3) }}</td></tr>{% endfor %}
</tbody></table>
{% endif %}
{% if "notes" in m.sections %}
<h3>Analyst actions</h3>
{% if r.labels %}<p>Labels: {% for l in r.labels %}{{ l.label | words }} by {{ l.author or "unknown" }} ({{ l.at[:19] }}){% if not loop.last %}; {% endif %}{% endfor %}.</p>{% endif %}
{% for n in r.notes %}<p><strong>{{ n.author or "unknown" }}</strong>, {{ n.created_at[:19] }}{% if n.edited %} (edited){% endif %}: {{ n.body }}</p>{% endfor %}
{% if not r.labels and not r.notes %}<p>None.</p>{% endif %}
{% endif %}
</section>
{% endif %}
{% endfor %}

<footer><p class="meta disclaimer">{{ m.disclaimer }}</p></footer>
</body>
</html>

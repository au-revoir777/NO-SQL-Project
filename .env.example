# Copy to .env and fill in. Never commit real values (.env is git-ignored).

# App-state database (users, cases, ...). SQLite by default; Postgres works too:
#   postgresql+psycopg://user:password@host:5432/fraudsim
DATABASE_URL=sqlite:///runs/app.db

# Session tokens. REQUIRED outside local development: a long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# 1 = cookies only over HTTPS (browsers also accept them on http://localhost)
COOKIE_SECURE=1

# Login rate limit (shared through Redis when REDIS_URL is set)
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900

# Hash-chained audit trail for logins and admin actions
APP_AUDIT_DIR=runs/app_audit

# Optional demo accounts, created at API start-up or with `fraudsim seed-users`.
# Passwords need at least 12 characters.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_ANALYST_EMAIL=
DEMO_ANALYST_PASSWORD=

# Services
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
REDIS_URL=

# Web app (server-side): where Next.js reaches FastAPI
API_BASE_URL=http://127.0.0.1:8000
